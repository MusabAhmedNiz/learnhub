# Copy to .env. Replace placeholders with your own development credentials.
# This example contains no working credentials.

# PostgreSQL connection used by Prisma CLI and the application.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/learnhub"

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# ImageKit credentials. Only the NEXT_PUBLIC_ endpoint is bundled for the browser;
# /api/upload returns the public key and short-lived upload authorization to admins.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your-imagekit-id"

# Polar: use sandbox credentials with `pnpm dev`.
# The checkout route uses production when NODE_ENV=production, including `pnpm start`.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# Admin seed only: set these before `pnpm exec prisma db seed`.
# Use a new email and a strong password; do not rely on the seed script's fallbacks.
EMAIL="admin@example.com"
PASSWORD=""
NAME="Local Admin"
