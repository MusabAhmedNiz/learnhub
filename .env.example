# Copy to .env. Replace placeholders with your own development credentials.
# Local storage credentials match compose.storage.yml; supply your own
# database, authentication, and payment configuration.

# PostgreSQL connection used by Prisma CLI and the application.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/learnhub"
# Optional direct database connection for migrations if DATABASE_URL is pooled.
DIRECT_URL=""

# Better Auth: generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# S3-compatible storage. Defaults below are for compose.storage.yml only.
# For R2: https://<account-id>.r2.cloudflarestorage.com, region auto,
# a private bucket, and bucket-scoped Object Read & Write credentials.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="learnhub"
S3_ACCESS_KEY_ID="learnhub-local"
S3_SECRET_ACCESS_KEY="learnhub-local-password"

# Polar: sandbox works in development and on hosted test deployments.
# Set production only when using live Polar credentials and products.
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""

# Admin seed only: set these before `pnpm exec prisma db seed`.
# Use a new email and a strong password; do not rely on the seed script's fallbacks.
EMAIL="admin@example.com"
PASSWORD=""
NAME="Local Admin"
